{
  "name": "dotfiles-catalog",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run test && bun run validate",
    "validate": "bun scripts/checkCatalog.ts",
    "test": "bun test --coverage scripts",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "oxlint --deny-warnings scripts",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "fix": "oxlint --fix scripts && bun run fmt"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "typescript": "7.0.2"
  }
}
